# Retort Environment Configuration
PORT=9847
HOSTNAME=0.0.0.0

# REQUIRED in production: >= 8 chars, not a default. Generate with: openssl rand -hex 16
ADMIN_SECRET=

# Set to 1 only when behind a trusted reverse proxy (Cloudflare, nginx) that sets
# cf-connecting-ip / x-forwarded-for. Otherwise those headers are ignored for rate limiting.
# TRUST_PROXY=1

# Extra cross-origin browsers allowed to open sockets (comma-separated, exact match).
# Same-origin and localhost are always allowed.
# ALLOWED_ORIGINS=https://game.example.com

# How long an empty room survives so players can reconnect (ms, default 180000)
# ROOM_GRACE_MS=180000

# Only if the socket server lives on a different origin than the web UI (baked in at build time)
# NEXT_PUBLIC_SOCKET_URL=
